{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/leon36000/ForgeAI-Toolkit/governance/authority.schema.json",
  "title": "authority-v1",
  "description": "Schéma descriptif de governance/authority.json (issue RC1-001 / #431). Documente la structure attendue pour lecture humaine et éditeurs — l'autorité d'application reste scripts/governance/validate_authority.py, qui reste stdlib pur et ne dépend pas de ce fichier.",
  "type": "object",
  "required": ["_schema", "_description", "generated_map", "vision_log", "inventory_commit", "owners", "scopes", "topics", "sources"],
  "additionalProperties": false,
  "properties": {
    "_schema": { "const": "authority-v1" },
    "_description": { "type": "string" },
    "generated_map": { "type": "string" },
    "vision_log": { "type": "string" },
    "inventory_commit": { "type": "string" },
    "owners": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["role"],
        "properties": { "role": { "type": "string" } },
        "additionalProperties": false
      }
    },
    "scopes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["singleton"],
        "properties": { "singleton": { "type": "boolean" } },
        "additionalProperties": false
      }
    },
    "topics": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["question", "vocabulaire"],
        "properties": {
          "question": { "type": "string" },
          "vocabulaire": {
            "type": "array",
            "items": { "type": "string" },
            "minItems": 1,
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/$defs/source" }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": [
        "id", "title", "path", "anchor", "kind", "scope", "version", "version_source",
        "status", "owner", "superseded_by", "prevails_over", "positions", "digest",
        "retention", "cleanup_issue", "resolution_issue", "decision", "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{2,63}$"
        },
        "title": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "anchor": { "type": ["string", "null"] },
        "kind": {
          "type": "string",
          "enum": ["doctrine", "spec", "adr", "decision", "ide_rules", "manifest", "data", "ledger", "story", "generated"]
        },
        "scope": { "type": "string" },
        "version": { "type": "string", "minLength": 1 },
        "version_source": {
          "type": "string",
          "enum": ["declared_in_file", "assigned_by_inventory"]
        },
        "status": {
          "type": "string",
          "enum": ["active", "conflicted", "superseded", "archived", "draft"]
        },
        "owner": { "type": "string" },
        "superseded_by": { "type": ["string", "null"] },
        "prevails_over": {
          "type": "array",
          "items": { "type": "string" }
        },
        "positions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["topic", "position", "locator"],
            "additionalProperties": false,
            "properties": {
              "topic": { "type": "string" },
              "position": { "type": "string" },
              "locator": { "type": "string" }
            }
          }
        },
        "digest": {
          "type": "object",
          "required": ["policy", "value", "checked_at", "delegated_to"],
          "additionalProperties": false,
          "properties": {
            "policy": {
              "type": "string",
              "enum": ["content_sha256", "section_sha256", "delegated", "none"]
            },
            "value": { "type": ["string", "null"] },
            "checked_at": { "type": "string" },
            "delegated_to": { "type": ["string", "null"] }
          }
        },
        "retention": {
          "type": "string",
          "enum": ["in_force", "historical_record", "pending_cleanup"]
        },
        "cleanup_issue": { "type": ["integer", "null"] },
        "resolution_issue": { "type": ["integer", "null"] },
        "decision": {
          "type": "object",
          "required": ["vision_log_seq", "mission_seq", "ref"],
          "additionalProperties": false,
          "properties": {
            "vision_log_seq": { "type": ["integer", "null"] },
            "mission_seq": { "type": ["integer", "null"] },
            "ref": { "type": ["string", "null"] }
          }
        },
        "notes": { "type": "string" }
      }
    }
  }
}

{
  "_doc": "Specs de déploiement réelles par brique (image vérifiée + config + wiring). Socle CPU branché.",
  "litellm": {
    "image": "ghcr.io/berriai/litellm:main-stable",
    "container_port": 4000,
    "health_path": "/health/liveliness",
    "volumes": [
      "./litellm-config.yaml:/app/litellm-config.yaml:ro"
    ],
    "env": {
      "LITELLM_MASTER_KEY": "${FORGEAI_LITELLM_KEY}",
      "LANGFUSE_PUBLIC_KEY": "${FORGEAI_LANGFUSE_PK}",
      "LANGFUSE_SECRET_KEY": "${FORGEAI_LANGFUSE_SK}",
      "LANGFUSE_HOST": "http://langfuse:3000"
    },
    "command": [
      "--config",
      "/app/litellm-config.yaml",
      "--port",
      "4000"
    ],
    "depends": [
      "ollama"
    ]
  },
  "redis": {
    "image": "redis:7.4.9",
    "container_port": 6379,
    "health_path": null,
    "volumes": [
      "forgeai-redis-data:/data"
    ],
    "env": {},
    "depends": []
  },
  "qdrant": {
    "image": "qdrant/qdrant:v1.18.3",
    "container_port": 6333,
    "health_path": "/readyz",
    "volumes": [
      "forgeai-qdrant-data:/qdrant/storage"
    ],
    "env": {},
    "depends": []
  },
  "text-embeddings-inference-tei": {
    "image": "ghcr.io/huggingface/text-embeddings-inference:cpu-1.9",
    "container_port": 80,
    "health_path": "/health",
    "volumes": [
      "forgeai-tei-data:/data"
    ],
    "env": {
      "MODEL_ID": "BAAI/bge-m3"
    },
    "depends": []
  },
  "text-embeddings-inference-reranker": {
    "image": "ghcr.io/huggingface/text-embeddings-inference:cpu-1.9",
    "container_port": 80,
    "health_path": "/health",
    "volumes": [
      "forgeai-tei-reranker-data:/data"
    ],
    "env": {
      "MODEL_ID": "BAAI/bge-reranker-v2-m3"
    },
    "depends": []
  },
  "immudb": {
    "image": "codenotary/immudb:1.11.1",
    "container_port": 8080,
    "health_path": "/",
    "volumes": [
      "forgeai-immudb-data:/var/lib/immudb"
    ],
    "env": {},
    "depends": []
  },
  "openbao": {
    "image": "openbao/openbao:2.6.0",
    "container_port": 8200,
    "health_path": "/v1/sys/health",
    "volumes": [],
    "env": {
      "BAO_DEV_ROOT_TOKEN_ID": "${FORGEAI_BAO_TOKEN}"
    },
    "depends": []
  },
  "postgres": {
    "image": "postgres:15-alpine",
    "container_port": 5432,
    "health_path": null,
    "volumes": [
      "forgeai-postgres-data:/var/lib/postgresql/data"
    ],
    "env": {
      "POSTGRES_PASSWORD": "${FORGEAI_PG_PASSWORD}",
      "POSTGRES_DB": "langfuse"
    },
    "depends": []
  },
  "langfuse": {
    "image": "langfuse/langfuse:2",
    "container_port": 3000,
    "health_path": "/api/public/health",
    "volumes": [],
    "env": {
      "DATABASE_URL": "postgresql://postgres:${FORGEAI_PG_PASSWORD}@postgres:5432/langfuse",
      "NEXTAUTH_URL": "http://localhost:3000",
      "NEXTAUTH_SECRET": "${FORGEAI_LANGFUSE_NEXTAUTH_SECRET}",
      "SALT": "${FORGEAI_LANGFUSE_SALT}",
      "ENCRYPTION_KEY": "${FORGEAI_LANGFUSE_ENCRYPTION_KEY}",
      "TELEMETRY_ENABLED": "false",
      "LANGFUSE_INIT_ORG_ID": "forgeai",
      "LANGFUSE_INIT_PROJECT_ID": "forgeai-rag",
      "LANGFUSE_INIT_PROJECT_PUBLIC_KEY": "${FORGEAI_LANGFUSE_PK}",
      "LANGFUSE_INIT_PROJECT_SECRET_KEY": "${FORGEAI_LANGFUSE_SK}",
      "LANGFUSE_INIT_USER_EMAIL": "admin@forgeai.local",
      "LANGFUSE_INIT_USER_NAME": "forgeai",
      "LANGFUSE_INIT_USER_PASSWORD": "${FORGEAI_LANGFUSE_UI_PASSWORD}"
    },
    "depends": [
      "postgres"
    ]
  },
  "llama-cpp-vulkan": {
    "image": "ghcr.io/ggml-org/llama.cpp:server-vulkan",
    "container_port": 8080,
    "health_path": "/health",
    "gpu": true,
    "volumes": [],
    "env": {},
    "command": [
      "-hf",
      "Qwen/Qwen2.5-0.5B-Instruct-GGUF:Q8_0",
      "-ngl",
      "99",
      "--host",
      "0.0.0.0",
      "--port",
      "8080"
    ],
    "depends": []
  },
  "cpu-zendnn": {
    "image": "amdih/zendnn_zentorch:vllm_v0.23.0_zentorch_v2.11.0.2_ubuntu22.04_v2.11.0.2",
    "container_port": 8000,
    "health_path": "/health",
    "gpu": false,
    "volumes": [],
    "env": {
      "ZENDNNL_MATMUL_ALGO": "1",
      "TORCHINDUCTOR_FREEZING": "1",
      "VLLM_USE_AOT_COMPILE": "0",
      "TORCHINDUCTOR_AUTOGRAD_CACHE": "0",
      "VLLM_CPU_KVCACHE_SPACE": "8"
    },
    "command": [
      "vllm",
      "serve",
      "Qwen/Qwen2.5-0.5B-Instruct",
      "--dtype",
      "bfloat16",
      "--host",
      "0.0.0.0",
      "--port",
      "8000"
    ],
    "depends": []
  },
  "intel-openvino": {
    "image": "openvino/model_server:latest",
    "container_port": 8000,
    "health_path": "/v3/models",
    "gpu": false,
    "volumes": [
      "ovms-models:/models"
    ],
    "env": {},
    "command": [
      "--source_model",
      "OpenVINO/Qwen2.5-1.5B-Instruct-int4-ov",
      "--model_repository_path",
      "/models",
      "--model_name",
      "qwen",
      "--rest_port",
      "8000",
      "--task",
      "text_generation",
      "--target_device",
      "AUTO",
      "--cache_size",
      "2"
    ],
    "depends": []
  }
}

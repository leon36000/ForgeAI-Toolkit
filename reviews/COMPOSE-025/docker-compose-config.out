name: forgeai-minimal
services:
  ollama:
    environment:
      FORGEAI_API_TOKEN: x
    image: ollama/ollama:latest
    networks:
      default: null
    ports:
      - mode: ingress
        host_ip: 127.0.0.1
        target: 11434
        published: "21434"
        protocol: tcp
    restart: unless-stopped
    security_opt:
      - no-new-privileges:true
    volumes:
      - type: volume
        source: vol-a
        target: /root/.ollama
        volume: {}
networks:
  default:
    name: forgeai-minimal_default
volumes:
  vol-a:
    name: forgeai-minimal_vol-a
